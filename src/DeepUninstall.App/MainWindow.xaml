<Window x:Class="DeepUninstall.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeepUninstall"
        Width="1120" Height="720" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindow}">

    <Grid Margin="20,16,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource AccentBrush}" VerticalAlignment="Center">
                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="DeepUninstall" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Remove programs completely, and safely." Style="{StaticResource Muted}" />
                </StackPanel>
            </StackPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="About" Click="About_Click" VerticalAlignment="Center" />
        </DockPanel>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TextBox x:Name="SearchBox" Style="{StaticResource InputBox}" Padding="30,6,8,6"
                         TextChanged="SearchBox_TextChanged" />
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource MutedTextBrush}"
                           Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                <TextBlock Text="Search by name or publisher" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Button Grid.Column="1" Margin="8,0,0,0" Click="Refresh_Click" ToolTip="Reload the list of installed programs">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                    <TextBlock Text="Refresh" Margin="8,0,0,0" />
                </StackPanel>
            </Button>

            <Button Grid.Column="3" x:Name="ForceButton" Margin="0,0,8,0" Click="Force_Click" IsEnabled="False"
                    ToolTip="Skip the program's own uninstaller and remove what is left directly. For broken entries.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                    <TextBlock Text="Force remove" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
            <Button Grid.Column="4" x:Name="UninstallButton" Style="{StaticResource PrimaryButton}" Click="Uninstall_Click" IsEnabled="False">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                    <TextBlock x:Name="UninstallButtonText" Text="Uninstall" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Program list -->
        <DataGrid Grid.Row="2" x:Name="AppsGrid" IsReadOnly="True" SelectionMode="Extended"
                  SelectionChanged="AppsGrid_SelectionChanged" MouseDoubleClick="AppsGrid_MouseDoubleClick">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Uninstall" Click="Uninstall_Click" />
                    <MenuItem Header="Force remove" Click="Force_Click" />
                    <Separator />
                    <MenuItem Header="Open install folder" Click="OpenFolder_Click" />
                    <MenuItem Header="Copy name" Click="CopyName_Click" />
                    <MenuItem Header="Copy uninstall command" Click="CopyCommand_Click" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Name" Width="2.4*" SortMemberPath="Name" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="22" Height="22" VerticalAlignment="Center">
                                    <Border CornerRadius="5" Background="{StaticResource AccentSoftBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" FontSize="11"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Style="{StaticResource Pill}" Background="{StaticResource WarningSoftBrush}" Margin="8,0,0,0"
                                        ToolTip="The uninstaller is missing. Use Force remove.">
                                    <Border.Visibility>
                                        <Binding Path="IsBroken" Converter="{StaticResource BoolToVisibility}" />
                                    </Border.Visibility>
                                    <TextBlock Text="Broken" FontSize="11" Foreground="{StaticResource WarningBrush}" />
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="1.5*" />
                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="*" />
                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="SizeBytes" Width="90" />
                <DataGridTextColumn Header="Installed" Binding="{Binding InstallDateText}" SortMemberPath="InstallDate" Width="100" />
                <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="1.4*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" x:Name="LoadingText" Text="Loading installed programs..." Style="{StaticResource Muted}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />

        <!-- Status bar -->
        <DockPanel Grid.Row="3" Margin="2,10,2,0">
            <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" />
            <TextBlock HorizontalAlignment="Right" Style="{StaticResource Muted}"
                       Text="Tip: select several programs to uninstall them one after another." />
        </DockPanel>
    </Grid>
</Window>
