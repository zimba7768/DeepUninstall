<Window x:Class="DeepUninstall.App.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uninstall"
        Width="980" Height="660" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource AppWindow}">

    <Grid Margin="20,16,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Grid Width="40" Height="40" DockPanel.Dock="Left" VerticalAlignment="Center">
                <Border x:Name="InitialBadge" CornerRadius="8" Background="{StaticResource AccentSoftBrush}">
                    <TextBlock x:Name="InitialText" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Image x:Name="AppIcon" RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
            <TextBlock x:Name="BatchText" DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="AppName" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="AppDetails" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Steps -->
            <Border Style="{StaticResource Card}" Padding="14,12">
                <ItemsControl x:Name="StepsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource BorderBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Running">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Done">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Warning">
                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Failed">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Skipped">
                                                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Content -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Options -->
                <Border x:Name="OptionsPanel" Style="{StaticResource Card}" Padding="22,18">
                    <StackPanel>
                        <Border x:Name="ForceWarning" Background="{StaticResource WarningSoftBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,16" Visibility="Collapsed">
                            <DockPanel>
                                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource WarningBrush}" FontSize="16" Margin="0,1,10,0" DockPanel.Dock="Left" />
                                <TextBlock x:Name="ForceWarningText" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" />
                            </DockPanel>
                        </Border>

                        <TextBlock Text="Before you start" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                        <CheckBox x:Name="RestorePointCheck" IsChecked="True" Margin="0,0,0,10">
                            <StackPanel Margin="4,0,0,0">
                                <TextBlock Text="Create a System Restore point first" />
                                <TextBlock Text="Lets you roll back the whole system if anything goes wrong. Takes up to a minute." Style="{StaticResource Muted}" FontSize="12" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox x:Name="SilentCheck" Margin="0,0,0,10">
                            <StackPanel Margin="4,0,0,0">
                                <TextBlock Text="Uninstall silently" />
                                <TextBlock x:Name="SilentHint" Style="{StaticResource Muted}" FontSize="12" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox x:Name="RecycleCheck" IsChecked="True" Margin="0,0,0,10">
                            <StackPanel Margin="4,0,0,0">
                                <TextBlock Text="Move removed files to the Recycle Bin" />
                                <TextBlock Text="Registry entries are always backed up to .reg files you can double-click to restore." Style="{StaticResource Muted}" FontSize="12" />
                            </StackPanel>
                        </CheckBox>

                        <TextBlock Text="What happens" Style="{StaticResource SectionTitle}" Margin="0,18,0,8" />
                        <TextBlock x:Name="WhatHappensText" TextWrapping="Wrap" Style="{StaticResource Muted}" LineHeight="20" />
                    </StackPanel>
                </Border>

                <!-- Leftovers -->
                <Grid x:Name="LeftoversPanel" Visibility="Hidden">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource LinkButton}" Content="Recommended" Click="SelectRecommended_Click" />
                            <Button Style="{StaticResource LinkButton}" Content="All" Click="SelectAll_Click" />
                            <Button Style="{StaticResource LinkButton}" Content="None" Click="SelectNone_Click" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Name="LeftoversTitle" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                       Text="High-confidence items are selected. Medium and low items might be shared with other software, so review them before selecting." />
                        </StackPanel>
                    </DockPanel>
                    <DataGrid Grid.Row="1" x:Name="LeftoversGrid" IsReadOnly="True" SelectionMode="Extended" PreviewKeyDown="LeftoversGrid_PreviewKeyDown">

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="44" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Type" Width="100" SortMemberPath="KindText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding KindText}" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Confidence" Width="96" SortMemberPath="Confidence">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                                    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Confidence}" Value="High">
                                                            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Confidence}" Value="Medium">
                                                            <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding ConfidenceText}" FontSize="11" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="2.2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding Location}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Why" Binding="{Binding Reason}" Width="1.4*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding Reason}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- Done -->
                <Border x:Name="DonePanel" Style="{StaticResource Card}" Padding="28,24" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                        <TextBlock x:Name="DoneGlyph" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="40"
                                   Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="DoneTitle" Style="{StaticResource SectionTitle}" FontSize="19" Margin="0,14,0,8" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock x:Name="DoneText" Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="20" />
                        <Button x:Name="OpenBackupsButton" Content="Open backup folder" Margin="0,18,0,0" HorizontalAlignment="Center"
                                Click="OpenBackups_Click" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- Log -->
                <Expander x:Name="LogExpander" Grid.Row="1" Header="Details" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBox x:Name="LogBox" Height="170" Margin="0,6,0,0" IsReadOnly="True" TextWrapping="NoWrap"
                             FontFamily="{StaticResource MonoFont}" FontSize="12"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" Padding="8" />
                </Expander>
            </Grid>
        </Grid>

        <!-- Footer -->
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="FooterText" Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="StopWaitingButton" Content="Stop waiting" Margin="8,0,0,0" Click="StopWaiting_Click" Visibility="Collapsed"
                        ToolTip="Stop waiting for the uninstaller and continue. Use this if it is stuck or left a window open." />
                <Button x:Name="SkipButton" Content="Skip cleanup" Margin="8,0,0,0" Click="Skip_Click" Visibility="Collapsed" />
                <Button x:Name="RemoveButton" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="Remove_Click" Visibility="Collapsed" />
                <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="Uninstall" Margin="8,0,0,0" Click="Start_Click" IsDefault="True" />
                <Button x:Name="CloseButton" Content="Cancel" Margin="8,0,0,0" Click="Close_Click" IsCancel="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
