<ui:FluentWindow x:Class="DeepUninstall.App.UninstallWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Uninstall"
                 Width="1020" Height="700" MinWidth="780" MinHeight="520"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" ShowMaximize="False" ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/DeepUninstall;component/Assets/icon-32.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Header -->
        <DockPanel Grid.Row="1" Margin="24,4,24,16">
            <Grid Width="48" Height="48" DockPanel.Dock="Left" VerticalAlignment="Center">
                <Border x:Name="InitialBadge" Style="{StaticResource InitialBadge}" CornerRadius="10">
                    <TextBlock x:Name="InitialText" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </Border>
                <Image x:Name="AppIcon" RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
            <Border x:Name="BatchChip" DockPanel.Dock="Right" Style="{StaticResource Chip}" VerticalAlignment="Center" Margin="0">
                <TextBlock x:Name="BatchText" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Border>
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="AppName" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="AppDetails" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Body -->
        <Grid Grid.Row="2" Margin="24,0,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Steps -->
            <Border Style="{StaticResource Surface}" Padding="16,14">
                <ItemsControl x:Name="StepsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,1,0,0">
                                    <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="20"
                                                   Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Done">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                        <Setter Property="Filled" Value="True" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Warning">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                        <Setter Property="Filled" Value="True" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Failed">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                        <Setter Property="Filled" Value="True" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                    <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Progress="30"
                                                     Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Tertiary}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Content -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Options -->
                <ScrollViewer x:Name="OptionsPanel" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ui:InfoBar x:Name="ForceWarning" Title="Force removal" Severity="Warning" IsClosable="False" Margin="0,0,0,12" />

                        <TextBlock Text="Before you start" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />

                        <Border Style="{StaticResource Surface}" Padding="18,14" Margin="0,0,0,6">
                            <DockPanel>
                                <ui:ToggleSwitch x:Name="RestorePointCheck" DockPanel.Dock="Right" IsChecked="True" VerticalAlignment="Center" />
                                <ui:SymbolIcon Symbol="ArrowUndo24" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Create a System Restore point" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Lets you roll back the whole system if anything goes wrong. Takes up to a minute." Style="{StaticResource Tertiary}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Surface}" Padding="18,14" Margin="0,0,0,6">
                            <DockPanel>
                                <ui:ToggleSwitch x:Name="SilentCheck" DockPanel.Dock="Right" VerticalAlignment="Center" />
                                <ui:SymbolIcon Symbol="EyeOff24" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Uninstall silently" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="SilentHint" Style="{StaticResource Tertiary}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Surface}" Padding="18,14" Margin="0,0,0,6">
                            <DockPanel>
                                <ui:ToggleSwitch x:Name="RecycleCheck" DockPanel.Dock="Right" IsChecked="True" VerticalAlignment="Center" />
                                <ui:SymbolIcon Symbol="Delete24" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Move removed files to the Recycle Bin" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Registry entries are always backed up and can be restored from the Backups page." Style="{StaticResource Tertiary}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="What happens" Style="{StaticResource SectionTitle}" Margin="0,18,0,8" />
                        <TextBlock x:Name="WhatHappensText" TextWrapping="Wrap" Style="{StaticResource Secondary}" LineHeight="22" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Leftovers -->
                <Grid x:Name="LeftoversPanel" Visibility="Hidden">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Appearance="Transparent" Content="Recommended" Click="SelectRecommended_Click" />
                            <ui:Button Appearance="Transparent" Content="All" Click="SelectAll_Click" />
                            <ui:Button Appearance="Transparent" Content="None" Click="SelectNone_Click" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Name="LeftoversTitle" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource Tertiary}" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Text="High-confidence items are selected. Medium and low items may be shared with other software; review them first." />
                        </StackPanel>
                    </DockPanel>
                    <Border Grid.Row="1" Style="{StaticResource Surface}" Padding="2">
                        <DataGrid x:Name="LeftoversGrid" IsReadOnly="True" SelectionMode="Extended" AutoGenerateColumns="False"
                                  HeadersVisibility="Column" GridLinesVisibility="None" CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserResizeRows="False" RowHeight="40" Background="Transparent" BorderThickness="0"
                                  PreviewKeyDown="LeftoversGrid_PreviewKeyDown">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="48" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" MinWidth="0" Padding="0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Type" Width="140" SortMemberPath="KindText">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{Binding KindText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Confidence" Width="100" SortMemberPath="Confidence">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Confidence}" Value="High">
                                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Confidence}" Value="Medium">
                                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding ConfidenceText}" FontSize="12" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="2.2*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="ToolTip" Value="{Binding Location}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Why" Binding="{Binding Reason}" Width="1.5*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="ToolTip" Value="{Binding Reason}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <!-- Done -->
                <Border x:Name="DonePanel" Style="{StaticResource Surface}" Padding="32,28" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                        <ui:SymbolIcon x:Name="DoneGlyph" Symbol="CheckmarkCircle24" Filled="True" FontSize="56" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                        <TextBlock x:Name="DoneTitle" FontSize="22" FontWeight="SemiBold" Margin="0,16,0,8" HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="DoneText" Style="{StaticResource Secondary}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="22" />
                        <ui:Button x:Name="OpenBackupsButton" Content="Open backup folder" Icon="{ui:SymbolIcon FolderOpen24}" Margin="0,20,0,0"
                                   HorizontalAlignment="Center" Click="OpenBackups_Click" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- Log -->
                <Expander x:Name="LogExpander" Grid.Row="1" Header="Details" Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBox x:Name="LogBox" Height="170" IsReadOnly="True" TextWrapping="NoWrap"
                             FontFamily="{StaticResource MonoFont}" FontSize="12"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                </Expander>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3" Margin="0,16,0,0" Padding="24,14" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock x:Name="FooterText" Style="{StaticResource Secondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button x:Name="StopWaitingButton" Content="Stop waiting" Margin="8,0,0,0" Click="StopWaiting_Click" Visibility="Collapsed"
                               ToolTip="Stop waiting for the uninstaller and continue. Use this if it is stuck or left a window open." />
                    <ui:Button x:Name="SkipButton" Content="Skip cleanup" Margin="8,0,0,0" Click="Skip_Click" Visibility="Collapsed" />
                    <ui:Button x:Name="RemoveButton" Appearance="Danger" Icon="{ui:SymbolIcon Delete24}" Margin="8,0,0,0" Click="Remove_Click" Visibility="Collapsed" />
                    <ui:Button x:Name="StartButton" Appearance="Primary" Icon="{ui:SymbolIcon Delete24}" Content="Uninstall" Margin="8,0,0,0" MinWidth="120"
                               Click="Start_Click" IsDefault="True" />
                    <ui:Button x:Name="CloseButton" Content="Cancel" Margin="8,0,0,0" MinWidth="90" Click="Close_Click" IsCancel="True" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
