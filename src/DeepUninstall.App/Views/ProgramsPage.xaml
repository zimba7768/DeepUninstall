<UserControl x:Class="DeepUninstall.App.Views.ProgramsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,4,0,18">
            <TextBlock Text="Programs" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="StatsText" Style="{StaticResource Secondary}" Margin="0,4,0,0" Text="Loading installed programs..." />
        </StackPanel>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:TextBox x:Name="SearchBox" Grid.Column="0" PlaceholderText="Search programs or publishers"
                        Icon="{ui:SymbolIcon Search24}" TextChanged="SearchBox_TextChanged" />
            <ComboBox x:Name="SortBox" Grid.Column="1" Width="190" Margin="8,0,0,0" SelectedIndex="0" SelectionChanged="SortBox_SelectionChanged">
                <ComboBoxItem Content="Sort by name" />
                <ComboBoxItem Content="Sort by size" />
                <ComboBoxItem Content="Sort by install date" />
                <ComboBoxItem Content="Sort by publisher" />
            </ComboBox>
            <ui:Button Grid.Column="2" Margin="8,0,0,0" Icon="{ui:SymbolIcon ArrowClockwise24}" Content="Refresh"
                       ToolTip="Reload the list of installed programs" Click="Refresh_Click" />
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Program list -->
            <Border Grid.Column="0" Style="{StaticResource Surface}" Padding="6">
                <Grid>
                    <ListView x:Name="AppsList" SelectionMode="Extended" BorderThickness="0" Background="Transparent"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ItemContainerStyle="{StaticResource ListRow}"
                              SelectionChanged="AppsList_SelectionChanged" MouseDoubleClick="AppsList_MouseDoubleClick"
                              KeyDown="AppsList_KeyDown">
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Uninstall" Click="Uninstall_Click" />
                                <MenuItem Header="Force remove" Click="Force_Click" />
                                <Separator />
                                <MenuItem Header="Open install folder" Click="OpenFolder_Click" />
                                <MenuItem Header="Copy name" Click="CopyName_Click" />
                                <MenuItem Header="Copy uninstall command" Click="CopyCommand_Click" />
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="50">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="30" Height="30" HorizontalAlignment="Left">
                                        <Border Style="{StaticResource InitialBadge}"
                                                Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                            <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        </Border>
                                        <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}" CornerRadius="4" Padding="6,0" Margin="8,0,0,0"
                                                    Visibility="{Binding IsBroken, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Broken" FontSize="11" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Tertiary}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,8,0" MinWidth="80">
                                        <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" Style="{StaticResource Secondary}" />
                                        <TextBlock Text="{Binding InstallDateText}" HorizontalAlignment="Right" Style="{StaticResource Tertiary}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <ui:ProgressRing x:Name="LoadingRing" IsIndeterminate="True" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock x:Name="EmptyText" Text="No programs match your search." Style="{StaticResource Secondary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
            </Border>

            <!-- Details -->
            <Border Grid.Column="2" Style="{StaticResource Surface}" Padding="20">
                <Grid>
                    <!-- Nothing selected -->
                    <StackPanel x:Name="NoSelectionPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="WindowApps24" FontSize="44" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="Select a program" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                        <TextBlock Style="{StaticResource Secondary}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="240"
                                   Text="Double-click to uninstall. Hold Ctrl to select several programs and remove them one after another." />
                    </StackPanel>

                    <!-- One program -->
                    <DockPanel x:Name="SinglePanel" Visibility="Collapsed">
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                            <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Delete24}" Content="Uninstall"
                                       HorizontalAlignment="Stretch" Height="38" Click="Uninstall_Click" />
                            <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Broom24}" Content="Force remove"
                                       HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="Force_Click"
                                       ToolTip="Skip the program's own uninstaller and remove what is left directly. For broken entries." />
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Grid Width="56" Height="56" HorizontalAlignment="Left">
                                    <Border Style="{StaticResource InitialBadge}" CornerRadius="12"
                                            Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                        <TextBlock Text="{Binding Initial}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>
                                    <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,14,0,2"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding Publisher}" Style="{StaticResource Secondary}" TextWrapping="Wrap" />

                                <ItemsControl ItemsSource="{Binding Tags}" Margin="0,14,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Chip}">
                                                <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ui:InfoBar Title="Uninstaller missing" Severity="Warning" IsClosable="False" Margin="0,6,0,0"
                                            Message="This program's uninstaller no longer exists. Use Force remove to clean it up."
                                            IsOpen="{Binding IsBroken, Mode=OneWay}" />

                                <TextBlock Text="Version" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding Version, TargetNullValue='—'}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Size" Style="{StaticResource FieldLabel}" />
                                <TextBlock x:Name="SizeValue" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Installed" Style="{StaticResource FieldLabel}" />
                                <TextBlock x:Name="DateValue" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Location" Style="{StaticResource FieldLabel}" />
                                <TextBlock x:Name="LocationValue" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <ui:Button x:Name="OpenFolderButton" Appearance="Transparent" Icon="{ui:SymbolIcon FolderOpen24}" Content="Open folder"
                                           Padding="6,4" Margin="-6,4,0,0" Click="OpenFolder_Click" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- Several programs -->
                    <DockPanel x:Name="MultiPanel" Visibility="Collapsed">
                        <ui:Button x:Name="UninstallManyButton" DockPanel.Dock="Bottom" Appearance="Primary" Icon="{ui:SymbolIcon Delete24}"
                                   HorizontalAlignment="Stretch" Height="38" Margin="0,16,0,0" Click="Uninstall_Click" />
                        <StackPanel DockPanel.Dock="Top">
                            <ui:SymbolIcon Symbol="AppsList24" FontSize="36" HorizontalAlignment="Left" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="MultiTitle" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Text="They will be uninstalled one after another. You review the leftovers of each one." />
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="MultiList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Margin="0,3" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
